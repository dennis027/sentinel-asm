# Settings for the production stack (docker-compose.prod.yml), on the server.
# Copy to .env.production on the server and fill in. Never commit .env.production.
#
#   cp .env.production.example .env.production

# ---- Django ----------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The address people use, e.g. densight.example.com (comma-separated for several).
DJANGO_ALLOWED_HOSTS=densight.example.com
CSRF_TRUSTED_ORIGINS=https://densight.example.com
CORS_ALLOWED_ORIGINS=https://densight.example.com
# True once TLS terminates in front of nginx (Caddy, Cloudflare, a load balancer).
DJANGO_HTTPS=True

# Where the web app is: the links in invitation and password-reset emails.
FRONTEND_URL=https://densight.example.com

# ---- Database: Neon (hosted Postgres) --------------------------------
# From the Neon console: Connection string, "Pooled connection" on.
# The -pooler address needs no extra settings: Densight detects it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---- Screenshots: Cloudflare R2 or S3 (optional with docker compose) --
# Leave S3_BUCKET empty to keep screenshots on the server's disk (fine for
# docker-compose.prod.yml, where the worker and the API share it). Required
# on Render, where they can't. R2: Cloudflare dashboard -> R2 -> create a
# bucket, then "Manage R2 API tokens" (Object Read & Write) for the keys.
S3_BUCKET=
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---- Redis (the compose "redis" service) ------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Email (alerts, the weekly report, invitations, password resets) --
# Without it, invitations still work (the admin copies the link), but
# forgotten-password emails can't be sent.
DEFAULT_FROM_EMAIL=alerts@densight.example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ---- Logs -------------------------------------------------------------
# The address servers and apps send their logs to.
ASM_LOG_INGEST_URL=https://densight.example.com/api/ingest/
# Densight's own logs to itself: connect a Python app under Logs and paste its key.
# DENSIGHT_LOG_KEY=dsl_...
