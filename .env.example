# Copy this to .env before running `docker compose up`.
# .env is gitignored -- never commit real secrets.

# --- Django ---
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required whenever DJANGO_DEBUG is off -- the app refuses to start without it.
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
# True for local development only. docker-compose.prod.yml forces it off.
DJANGO_DEBUG=True
# Comma-separated hostnames the site is served on, e.g. asm.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origin of the Angular dev server. Not needed in production (same origin).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Production only ---
# Set to True when the site is served over HTTPS (secure cookies, HSTS).
# DJANGO_HTTPS=True
# Needed for /admin/ logins over HTTPS, e.g. https://asm.example.com
# CSRF_TRUSTED_ORIGINS=https://asm.example.com
# Trusted reverse proxies in front of the API. Leave unset (0) when the
# API is reached directly; docker-compose.prod.yml sets it to 1 for nginx.
# NUM_PROXIES=1
# Bearer token Prometheus must send to scrape /metrics. Without it,
# /metrics only works when DJANGO_DEBUG is on.
# METRICS_TOKEN=
# Host port the production nginx listens on.
# WEB_PORT=80

# --- Scan safety ---
# Organizations must publish a DNS TXT record proving they control their
# domain before it can be scanned. Defaults to on whenever DJANGO_DEBUG
# is off; set False only on a private instance where every user is trusted.
# ASM_REQUIRE_DOMAIN_VERIFICATION=True
# Allow scanning hosts that resolve to private/loopback addresses.
# Leave off unless you are deliberately scanning your own internal network.
# ASM_ALLOW_PRIVATE_SCAN_TARGETS=False

# Pages the screenshot scanner captures per asset (landing page + linked pages).
# ASM_SCREENSHOT_MAX_PAGES=6

# --- Postgres ---
# These two blocks must stay in sync: POSTGRES_* configures the db
# container itself; DATABASE_URL is how Django connects to it.
POSTGRES_DB=asm_platform
POSTGRES_USER=asm_user
POSTGRES_PASSWORD=asm_password
DATABASE_URL=postgres://asm_user:asm_password@db:5432/asm_platform

# --- Redis (Celery broker/result backend + Django cache) ---
REDIS_URL=redis://redis:6379/0

# --- Email (SMTP provider) ---
# Left commented out, notification emails are printed to the
# celery-worker logs instead of being sent -- nothing to set up locally.
# Uncomment and fill in to send real email.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=alerts@sentinel-asm.local

# Server logs: the address client servers send their logs to, as they can
# reach it (behind your proxy/TLS). Shown in the setup steps for each server.
# Densight watching itself: connect a Python app under Logs, then paste its
# ingest key here. The API, worker and beat send their own logs (errors with
# stack traces, failed scans, warnings) to it. Optional overrides shown.
# DENSIGHT_LOG_KEY=dsl_...
# DENSIGHT_LOG_URL=http://api:8000/api/ingest/
# DENSIGHT_LOG_LEVEL=INFO
# ASM_LOG_INGEST_URL=https://densight.yourcompany.com/api/ingest/

# ---- Accounts ----
# Where the web app is: the links in invitation and password-reset emails.
# FRONTEND_URL=http://localhost:4200
# INVITATION_TTL_DAYS=7
# Password-reset links, in seconds (1 hour).
# PASSWORD_RESET_TIMEOUT=3600
# Password resets need real email: set EMAIL_HOST and friends above.

# ---- Limits ----
# API requests per signed-in user / per address when not signed in.
# API_RATE_USER=1200/min
# API_RATE_ANON=120/min
# Finished scan jobs older than this many days are deleted nightly (0 = keep).
# ASM_SCAN_JOB_RETENTION_DAYS=90

